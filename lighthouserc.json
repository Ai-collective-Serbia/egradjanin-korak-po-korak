{
  "ci": {
    "collect": {
      "startServerCommand": "npm run preview",
      "startServerReadyPattern": "Local",
      "startServerReadyTimeout": 30000,
      "numberOfRuns": 1,
      "url": [
        "http://127.0.0.1:4321/egradjanin-korak-po-korak/",
        "http://127.0.0.1:4321/egradjanin-korak-po-korak/step/have-id-card/",
        "http://127.0.0.1:4321/egradjanin-korak-po-korak/step/register-euprava/",
        "http://127.0.0.1:4321/egradjanin-korak-po-korak/step/post-office-card/",
        "http://127.0.0.1:4321/egradjanin-korak-po-korak/lat/step/have-id-card/"
      ],
      "settings": {
        "formFactor": "mobile",
        "screenEmulation": {
          "mobile": true,
          "width": 390,
          "height": 844,
          "deviceScaleFactor": 3,
          "disabled": false
        }
      }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 0.9 }],
        "categories:best-practices": ["warn", { "minScore": 0.9 }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": ".lighthouseci" }
  }
}
