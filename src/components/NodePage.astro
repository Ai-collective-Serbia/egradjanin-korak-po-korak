---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { formatDate } from '../lib/dates';
import { groupPosition, guideChecked, isHelpNode, outgoing } from '../lib/graph';
import { makeT } from '../lib/i18n';
import { homePath, nodePath, withBase } from '../lib/paths';
import { collectionFor, type Script } from '../lib/script';
import { bodyIds, graph, overrides, ui } from '../lib/site';

interface Props {
  script: Script;
  id: string;
  /** Render as the site's home page: no back button, plus the resume block for returning visitors. */
  home?: boolean;
}

const { script, id, home = false } = Astro.props;
const node = graph.nodes[id];
if (!node) throw new Error(`unknown node "${id}"`);

const t = makeT(script, overrides);
const base = import.meta.env.BASE_URL;
const entry = bodyIds.has(id) ? await getEntry(collectionFor(script), id) : undefined;
const Content = entry ? (await render(entry)).Content : null;
const edges = outgoing(node);
const position = groupPosition(graph, id);
const external = node.type === 'step' ? node.external : undefined;
/**
 * End screens have no Back (testers found it confusing). A finish screen offers a feedback e-mail
 * button instead: the reader is done and has no reason to go home. Help screens (ids starting with
 * "help-") are end screens reached mid-flow, so they keep Back and the home button.
 */
const isEnd = node.type === 'end';
const showBack = !home && (!isEnd || isHelpNode(id));
/** The intro screen says when the whole guide was last checked; it renders as the home page and as its own step. */
const checkedLine =
  id === graph.start ? `${ui.lastChecked}: ${formatDate(guideChecked(graph))}` : undefined;
---

<Base
  script={script}
  title={node.title}
  pagePath={home ? '' : nodePath('cyr', id)}
  nodeId={home ? undefined : id}
  nodeType={home ? undefined : node.type}
>
  <article class={`node node-${node.type}`}>
    {home && (
      <>
        <div data-fresh></div>
        <div class="resume" data-resume hidden>
          <a class="btn btn-primary" data-resume-link href={withBase(base, nodePath(script, id))}>
            {t(ui.resume)}
          </a>
          <button
            type="button"
            class="btn btn-secondary"
            data-reset
            data-confirm={t(ui.resetConfirm)}
          >
            {t(ui.reset)}
          </button>
        </div>
      </>
    )}
    {position && (
      <p class="progress">
        {t(position.name)} · {t(ui.progressPart)} {position.index} {t(ui.progressOf)}{' '}
        {position.total}
      </p>
    )}
    <h1>{t(node.title)}</h1>
    {Content && (
      <div class="body">
        <Content />
      </div>
    )}
    {checkedLine && <p class="checked">{t(checkedLine)}</p>}
    {external && (
      <>
        <p class="external">
          <a class="btn btn-external" href={external.url} target="_blank" rel="noopener">
            {t(external.label)}
            <span class="visually-hidden"> ({t(ui.opensNewTab)})</span>
          </a>
        </p>
        <p class="after-external">{t(ui.afterExternal)}</p>
      </>
    )}
    {home && <p class="disclaimer">{t(ui.disclaimer)}</p>}
    {edges.length > 0 && (
      <nav class="answers" aria-label={t(ui.answersLabel)}>
        {edges.map((edge) => (
          <a
            class="btn btn-answer"
            href={withBase(base, nodePath(script, edge.next))}
            data-answer={edge.label ?? ui.next}
          >
            {t(edge.label ?? ui.next)}
          </a>
        ))}
      </nav>
    )}
    {node.type === 'card' && (
      <p class="print">
        <button type="button" class="btn btn-secondary" onclick="window.print()">
          {t(ui.print)}
        </button>
      </p>
    )}
    {showBack && (
      <nav class="nav-back" aria-label={t(ui.back)}>
        <a class="btn btn-secondary" data-back href={withBase(base, homePath(script))}>
          {t(ui.back)}
        </a>
      </nav>
    )}
    {isEnd && !isHelpNode(id) && (
      <nav class="nav-feedback" aria-label={t(ui.feedback)}>
        <a
          class="btn btn-secondary"
          href={`mailto:${ui.feedbackEmail}?subject=${encodeURIComponent(t(ui.feedbackSubject))}`}
        >
          {t(ui.feedback)}
        </a>
      </nav>
    )}
    {isEnd && isHelpNode(id) && (
      <nav class="nav-home" aria-label={t(ui.toHome)}>
        <a class="btn btn-secondary" href={withBase(base, homePath(script))}>
          {t(ui.toHome)}
        </a>
      </nav>
    )}
  </article>
</Base>
